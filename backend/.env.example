# =============================================================================
# CollabSphere — Environment Variable Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=collabsphere
DB_USER=collabsphere
DB_PASSWORD=Shruthi@0508
DB_SSLMODE=disable
DATABASE_URL=postgres://collabsphere:Shruthi@0508@localhost:5432/collabsphere?sslmode=disable

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
API_PORT=8080
API_ENV=development
# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=changeme_generate_a_real_secret_with_openssl_rand_hex_32
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# CORS — comma-separated allowed origins (e.g. https://collabsphere.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Frontend client URL (used for password reset and email verification links)
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
PUBLIC_WS_URL=ws://localhost:8080/ws

# ---------------------------------------------------------------------------
# Email (SMTP)
# If not configured, verification emails are logged to console in dev mode.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@collabsphere.dev
EMAIL_ENABLED=false

# ---------------------------------------------------------------------------
# AI Service (Python FastAPI)
# ---------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_ENABLED=false

# LLM provider (optional — for project idea assistant)
# Supported: openai, gemini, none
LLM_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# File Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ---------------------------------------------------------------------------
# Redis (session store, rate limiting, pub/sub for WebSocket)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# GitHub Integration (Phase 6 — repository links only in Phase 1)
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Comma-separated email addresses that are auto-granted admin on first login
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
