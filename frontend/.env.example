# =============================================================================
# CollabSphere Frontend — Environment Variable Template
# Copy to .env or set in your production build pipeline (e.g. Vercel, Netlify, Node)
# =============================================================================

# Public REST API base URL (must include /api/v1)
# Local: http://localhost:8080/api/v1
# Production: https://api.yourdomain.com/api/v1
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Public WebSocket URL (Phase 3+ real-time features)
# Local: ws://localhost:8080/ws
# Production: wss://api.yourdomain.com/ws
PUBLIC_WS_URL=ws://localhost:8080/ws
